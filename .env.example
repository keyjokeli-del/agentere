# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA MULTI-AGENTE DENTAL (100% GRATUITO)
# ==============================================================================

# --- IA Groq Cloud (API Gratuita: https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_your_free_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Calendar API (Consola de Google Cloud gratuita) ---
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- Datos de la Clínica Dental ---
CLINIC_NAME="Clínica Dental Sonrisas"
CLINIC_ADDRESS="Av. Principal 123, Consultorio 402"
CLINIC_PHONE="+54 9 11 1234-5678"
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=19
SLOT_DURATION_MINUTES=45

# --- Meta Webhooks (Facebook & Instagram - Modo Desarrollo Gratuito) ---
META_VERIFY_TOKEN=dental_agent_token_2026

# --- Base de Datos Neon Serverless PostgreSQL (Capa Gratuita: https://neon.tech) ---
# Guarda permanentemente la sesión de Baileys para evitar desconexiones tras reinicios
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
WA_SESSION_ID=dental_clinic_session

# --- Puertos de Servicios ---
PORT=8000
WHATSAPP_SERVICE_PORT=3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_URL=http://localhost:3001

# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA MULTI-AGENTE "LUMINA DENTAL STUDIO" ($0 USD)
# ==============================================================================

# --- 1. IA Groq Cloud (Capa Gratuita: https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# --- 2. Google Calendar API (Capa Gratuita de Google Cloud Console) ---
GOOGLE_CALENDAR_ID=primary
# En local: ruta al archivo descargado
GOOGLE_CREDENTIALS_FILE=credentials.json
# En producción (Render): pega el contenido JSON completo de service_account.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# --- 3. Datos de la Clínica Dental ---
CLINIC_NAME="Lumina Dental Studio"
CLINIC_ADDRESS="Av. Santa Fe 2450, Piso 3, Consultorio B, CABA"
CLINIC_PHONE="+54 9 11 4567-8900"
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=19
SLOT_DURATION_MINUTES=45

# --- 4. Meta Webhooks (Facebook & Instagram - Modo Desarrollo Gratuito) ---
META_VERIFY_TOKEN=lumina_agent_token_2026

# --- 5. Base de Datos Neon Serverless PostgreSQL (Capa Gratuita: https://neon.tech) ---
# Guarda permanentemente la sesión de Baileys para evitar desconexiones tras reinicios
NEON_DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
WA_SESSION_ID=lumina_dental_session

# --- 6. Puertos y URLs de Enlace ---
PORT=8000
WHATSAPP_SERVICE_PORT=3001
PYTHON_BACKEND_URL=http://localhost:8000/api/webhooks/whatsapp

# Variables para Frontend en Next.js (en Vercel configurar con las URLs públicas de Render)
# En local:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_URL=http://localhost:3001
# En producción (ejemplo):
# NEXT_PUBLIC_BACKEND_URL=https://lumina-backend.onrender.com
# NEXT_PUBLIC_WHATSAPP_URL=https://lumina-whatsapp.onrender.com
